# For real responses, provide an API key and keep MOCK_OPENAI=false.
OPENAI_API_KEY=sk-your-key
# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
# Set true in a preview deployment to return a fixed streamed demo response.
# The API key is not required in mock mode.
MOCK_OPENAI=false
# Optional Basic Auth for an internet deployment. Username defaults to "preview".
# APP_USERNAME=preview
# APP_PASSWORD=choose-a-long-random-password
